{
    "name": "moduspromethean/fire-sdk",
    "description": "PHP SDK for the Fire AI Inference API (v1 chat + v2 multi-agent flows)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "ModusPromethean\\FireSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModusPromethean\\FireSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
